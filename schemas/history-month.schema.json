{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://month-in-history-wall.local/schemas/history-month.schema.json",
  "title": "Month in History Wall import",
  "type": "object",
  "additionalProperties": false,
  "required": ["month", "year", "events"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "month": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "year": {
      "type": "integer",
      "minimum": -5000,
      "maximum": 3000
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "published"]
    },
    "layoutSeed": {
      "type": "string",
      "description": "Optional stable seed used to randomize tile order deterministically."
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "summary", "category", "relevanceScore", "sources"],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "string"
          },
          "whyItMatters": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "description": "Prefer ISO 8601 dates, such as 1984-06-06 or 1984-06-06T14:00:00Z."
          },
          "dateRange": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start", "end"],
            "properties": {
              "start": { "type": "string" },
              "end": { "type": "string" }
            }
          },
          "location": {
            "type": "string"
          },
          "countries": {
            "type": "array",
            "items": { "type": "string" }
          },
          "relevanceScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "Relative importance inside this month. The seeder ranks these scores to assign tile sizes."
          },
          "media": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "url", "alt"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["image", "gif", "video"]
              },
              "url": {
                "type": "string"
              },
              "alt": {
                "type": "string",
                "minLength": 1
              },
              "caption": {
                "type": "string"
              },
              "credit": {
                "type": "string"
              },
              "license": {
                "type": "string"
              }
            }
          },
          "detailMarkdown": {
            "type": "string",
            "description": "Optional markdown body for the event detail page."
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "url"],
              "properties": {
                "title": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "minLength": 1 },
                "publisher": { "type": "string" },
                "author": { "type": "string" },
                "publishedAt": { "type": "string" },
                "accessedAt": { "type": "string" },
                "sourceType": {
                  "type": "string",
                  "enum": ["encyclopedia", "archive", "official", "news", "academic", "reference", "other"]
                },
                "notes": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
