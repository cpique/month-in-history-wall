# Copy these names into .env.local when MongoDB persistence is enabled.
# Local Docker example: docker run --name one-month-museum-mongo -p 27017:27017 -d mongo:7
# Then use: MONGODB_URI=mongodb://localhost:27017
MONGODB_URI=
MONGODB_DB=one-month-museum

# Stripe configuration for payment authorization and capture.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk configuration for admin authentication.
# Copy the publishable and secret keys from the Clerk dashboard API keys page.
# Configure sign-in and sign-up URLs in Clerk to use the admin paths below.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/admin/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/admin/sign-up
